# 把这个文件复制成 .env，然后填入你自己的配置。
# .env 已经在 .gitignore 里，不会被上传到 GitHub；这个 env.example 会。
# 复制命令：cp env.example .env

# 1) 你的 API Key（火山方舟控制台 → API Key 管理）
MEDQA_API_KEY=在这里填你的key

# 2) 接口地址（火山方舟固定是这个）
MEDQA_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 3) 模型或接入点 ID（形如 ep-xxxxxxxx，或豆包的模型名）
MEDQA_MODEL=在这里填接入点ID或模型名

# 4) 裁判模型（可选）：不填就沿用上面的考生配置。
#    想让裁判换一家平台（例如考生豆包、裁判 DeepSeek）时，取消下面三行的注释并填写。
# MEDQA_JUDGE_BASE_URL=https://api.deepseek.com/v1
# MEDQA_JUDGE_MODEL=deepseek-flash
# MEDQA_JUDGE_API_KEY=在这里填裁判平台的key

# 5) 裁判输出预算（可选）：推理型裁判会先「思考」再输出，预算太小会导致返回空内容。
#    默认 3000，建议设到 8000。
# MEDQA_JUDGE_MAX_TOKENS=8000
